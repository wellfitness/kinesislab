# Normalizacion de finales de linea.
# El repositorio almacena siempre LF; Windows ya no reescribe ficheros enteros.
* text=auto eol=lf

# Scripts que Windows exige en CRLF para ejecutarse
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Wrapper de Gradle: debe conservar LF aunque se edite en Windows
gradlew text eol=lf
*.sh    text eol=lf

# Binarios: git no debe tocarlos jamas
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.gif   binary
*.ico   binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
*.mp3   binary
*.wav   binary
*.jks   binary
*.keystore binary
*.zip   binary
*.apk   binary
*.aab   binary
*.jar   binary
*.pdf   binary
